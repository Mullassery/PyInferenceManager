# PyInferenceManager — environment configuration
#
# Copy this file to `.env` (or export these directly in your shell) and fill
# in the keys for whichever cloud providers you want to use. None of these
# are required to use Ollama-only local inference.

# --- Cloud provider API keys -------------------------------------------
# Only needed for the providers you actually route to. At least one is
# required for Orchestrator(mode="cloud_first") to reach a cloud model.

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini — https://aistudio.google.com/apikey
# Either variable works; GEMINI_API_KEY is checked first.
GEMINI_API_KEY=...
# GOOGLE_API_KEY=...

# --- Optional: override provider API base URLs --------------------------
# Useful for self-hosted proxies, Azure OpenAI-style endpoints, or pointing
# at a local mock server in tests. Leave unset to use the real public APIs.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Local inference (Ollama) --------------------------------------------
# No API key needed. PyInferenceManager talks to a local Ollama server;
# override the URL if it's not running on the default port.
# OLLAMA_BASE_URL is read from OrchestratorConfig, not the environment, as
# of this version — configure it in code if you need a non-default host.
