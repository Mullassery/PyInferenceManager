.idea/
*.swp
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

# Compiled PyO3 extension module (built locally via `maturin develop`/`maturin
# build` into src/pyinferencemanager/ — never hand-committed; a compiled .so
# previously ended up committed by an automated "cleanup bot" pass that also
# flattened the package out of src/ into a repo-root layout, which shadowed
# the real installed wheel for anything run with the repo root as cwd. Moved
# back to src/ layout; keep this ignore rule so a local maturin build never
# gets hand-committed again.
src/pyinferencemanager/_core*.so
src/pyinferencemanager/_core*.pyd

# Editor/manual backup files (a stale README.md.bak and __init__.py.bak
# previously shipped in the repo and silently contradicted the real files).
*.bak

# Virtual environments
venv/
env/
.venv

# Rust
target/
Cargo.lock

# Temp files
*.tmp
*.log
temp/
tmp/
